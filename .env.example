# Set these in Replit Secrets. Replit's Postgres adds DATABASE_URL for you.
DATABASE_URL=postgres://user:password@host:5432/db
ADMIN_PASSWORD=choose-a-long-password
# Optional. Generated and stored in the database if left out.
# SESSION_SECRET=
# Optional: a site to point visitors to from the home page
# HOME_URL=
# Optional: redirect every other host here, e.g. docs.tung.digital
# CANONICAL_HOST=
OWNER_NAME=Tung Nguyen
